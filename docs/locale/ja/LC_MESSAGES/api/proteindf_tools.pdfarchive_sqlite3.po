msgstr "HOMOのレベルを返す 0から始まることに注意。"

#: b9ba66d4ebd442fab63c41b23ca4e959 of
#: proteindf_tools.pdfarchive_sqlite3.PdfArchive_Sqlite3.get_basisset:1
msgid ""
"Return the basis function information (Basis object) for the given name."
msgstr "与えられた名前の基底関数情報(Basisオブジェクト)を返す"

#: 62fa8d7b88b24dfab8311cb9b7e02893 of
#: proteindf_tools.pdfarchive_sqlite3.PdfArchive_Sqlite3.get_basisset_name:1
msgid "Return the name corresponding to the atom name (atom_label)."
msgstr "原子名(atom_label)に対応する名前を返す"

#: dd28727f4763459fb1be8c132e48c5f0 of
#: proteindf_tools.pdfarchive_sqlite3.PdfArchive_Sqlite3.get_energylevel:1
