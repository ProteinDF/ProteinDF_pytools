"軌道種類の文字列を返す shell_type_id=0, basis_id=0: s shell_type_id=1, basis_id=0: px "
"shell_type_id=1, basis_id=1: py shell_type_id=1, basis_id=2: pz "
"shell_type_id=2, basis_id=0: dxy shell_type_id=2, basis_id=1: dyz "
"shell_type_id=2, basis_id=2: dzx shell_type_id=2, basis_id=3: dxx-yy "
"shell_type_id=2, basis_id=4: dzz"

